{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/poll-alerts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/poll-news",
      "schedule": "*/10 * * * *"
    }
  ]
}
