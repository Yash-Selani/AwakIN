# PostgreSQL Database Configuration
# For production (Neon / Vercel Postgres), set DATABASE_URL directly:
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/awakin_db?sslmode=require
POSTGRES_USER=awakin_user
POSTGRES_PASSWORD=awakin_password
POSTGRES_DB=awakin_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gemini API Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration
# Local dev: path to service account JSON file
FIREBASE_CREDENTIALS_PATH=path/to/your/firebase-adminsdk.json
# Vercel / Serverless: base64-encoded service account JSON
# FIREBASE_CREDENTIALS_JSON=eyJhbGci...
FIREBASE_PROJECT_ID=your_firebase_project_id

# External APIs & Feeds
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml

# Security & Deployment
CRON_SECRET=your_random_cron_secret_here
CORS_ORIGINS=http://localhost:5173
